# Default npm run dev uses an isolated embedded Postgres database.
# npm run dev:postgres / npm start require a private DATABASE_URL.
YOGILIB_DATABASE=pglite
# DATABASE_URL=
# YOGILIB_ALLOW_MIGRATIONS=1 # explicitly enabled only for a development DB
# YOGILIB_UPLOAD_DIR=.local/uploads
# LEGACY_UPLOAD_DIR= # absolute path to existing static/docs (read only)
# S3_BUCKET=
# S3_ENDPOINT=
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PUBLIC_APP_ORIGIN=https://your-approved-host
# VITE_API_URL=https://your-approved-host # required for mobile build

# Reader self-registration is open by default (always creates "viewer" accounts).
# YOGILIB_REGISTRATION=closed

# AI reading companion (off unless a key is set). Server-side only; never expose to the browser.
# ANTHROPIC_API_KEY=
# YOGILIB_AI_DAILY_LIMIT=20   # requests per signed-in reader per 24h
# YOGILIB_AI_MODEL=claude-opus-5-5

# Contributions. Each provider stays hidden until its secret is set. Sandbox unless *_ENV=live.
# ESEWA_SECRET_KEY=
# ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_ENV=sandbox
# KHALTI_SECRET_KEY=
# KHALTI_ENV=sandbox
# STRIPE_SECRET_KEY=
# STRIPE_CURRENCIES=USD

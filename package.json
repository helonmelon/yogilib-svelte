{
  "name": "yogilib",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:offline && cross-env YOGILIB_DATABASE=pglite vite --host 127.0.0.1 --port 5173",
    "dev:postgres": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
    "build": "npm run build:offline && vite build",
    "build:mobile": "node scripts/check-mobile.mjs && cross-env MOBILE_BUILD=1 VITE_MOBILE=1 vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "cross-env BODY_SIZE_LIMIT=32M node --env-file-if-exists=.env.local build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "build:offline": "vite build --config vite.offline.config.ts && node scripts/offline-worker.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.md docs/*.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/labrada": "^5.3.0",
    "@sveltejs/kit": "^2.62.0",
    "bcryptjs": "^3.0.2",
    "idb": "^8.0.3",
    "pg": "^8.16.3",
    "quill": "^2.0.3",
    "sanitize-html": "^2.17.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
